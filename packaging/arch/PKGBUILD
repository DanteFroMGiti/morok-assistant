pkgname=morok-assistant
pkgver=0.2.1
pkgrel=1
pkgdesc="Animated desktop companion and AI assistant for Linux"
arch=('any')
url="https://github.com/DanteFroMGiti/morok-assistant"
license=('custom')
depends=('python' 'pyside6' 'glib2' 'xorg-xprop')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
    'ollama: local AI models'
    'libpulse: detection of active audio playback through pactl'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
    install -Dm644 morok-assistant.desktop \
        "$pkgdir/usr/share/applications/morok-assistant.desktop"
    install -Dm644 morok-icon.png \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/morok-icon.png"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
